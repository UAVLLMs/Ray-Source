# Authentication shared only with trusted API clients or the web-client server.
KAFU_API_TOKEN=replace-with-a-long-random-token

# Answer generation and translation (OpenAI-compatible Responses API).
SILICONFLOW_BASE_URL=https://your-openai-compatible-endpoint
SILICONFLOW_API_KEY=replace-with-generation-key
SILICONFLOW_MODEL=gpt-5.6-terra
SILICONFLOW_WIRE_API=responses
SPATIAL_PRIMARY_MAX_CONCURRENCY=3

# Optional second credential for the same provider. Keep this server-side only.
SPATIAL_SECONDARY_API_KEY=replace-with-second-generation-key
SPATIAL_SECONDARY_BASE_URL=https://your-openai-compatible-endpoint
SPATIAL_SECONDARY_MODEL=gpt-5.6-terra
SPATIAL_SECONDARY_WIRE_API=responses
SPATIAL_SECONDARY_MAX_CONCURRENCY=3
LLM_CIRCUIT_FAILURE_THRESHOLD=2
LLM_CIRCUIT_NETWORK_OPEN_SECONDS=12
LLM_CIRCUIT_RATE_LIMIT_OPEN_SECONDS=20

# Shared Dense/rerank/final-retrieval cache. Index generation is part of every key.
REDIS_URL=redis://127.0.0.1:6379/0
RETRIEVAL_REDIS_CACHE_ENABLED=1
RETRIEVAL_CACHE_NAMESPACE=raysource:retrieval:v1
RETRIEVAL_CACHE_TTL_SECONDS=3600

# Service/manual classifier. It may use the same endpoint and key.
CLASSIFIER_BASE_URL=https://your-openai-compatible-endpoint
CLASSIFIER_API_KEY=replace-with-classifier-key
CLASSIFIER_MODEL=gpt-5.6-luna
CLASSIFIER_WIRE_API=responses

# Retrieval providers. Pure BM25 remains available if these are temporarily down.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace-with-embedding-key
EMBEDDING_MODEL=Pro/BAAI/bge-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=replace-with-rerank-key
RERANK_MODEL_ALIAS=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=1

CHAT_TIMEOUT_S=300
CHAT_MULTIMODAL_TIMEOUT_S=60
CHAT_SESSION_HISTORY_LIMIT=6
RETURN_PARENT_SECTION=1
CHAT_API_TRACE_PATH=logs/chat.trace.jsonl

# Optional. Defaults to retrieval-service/data/manual-images so the backend can
# run without a web-client directory on the same machine.
RAYSOURCE_MANUAL_IMAGE_DIR=
