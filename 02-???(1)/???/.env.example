WEB_HOST=127.0.0.1
WEB_PORT=3000

# This can point to another machine. Do not add a trailing path.
RAGV6_API_ORIGIN=http://127.0.0.1:8014
RAGV6_CHAT_ORIGIN=http://127.0.0.1:8014
RAGV6_CHAT_BACKEND=vnext-fast
RAGV6_API_TOKEN=replace-with-the-same-token-as-KAFU_API_TOKEN
RAGV6_DEFAULT_PROFILE=v6-terra
RAGV6_REQUEST_TIMEOUT_MS=360000

# One shared scheduler for web, WeCom, QQ and generic API chat traffic.
RAGV6_CHAT_MAX_CONCURRENCY=4
RAGV6_CHAT_MAX_QUEUE=8
RAGV6_CHAT_MAX_QUEUE_WEB=8
RAGV6_CHAT_MAX_QUEUE_WECOM=8
RAGV6_CHAT_MAX_QUEUE_QQ=8
RAGV6_CHAT_MAX_QUEUE_API=8
RAGV6_CHAT_QUEUE_TIMEOUT_MS=120000
RAGV6_CHAT_SESSION_QUEUE_LIMIT=2
RAGV6_CHAT_WEIGHT_WEB=2
RAGV6_CHAT_WEIGHT_WECOM=1
RAGV6_CHAT_WEIGHT_QQ=1
RAGV6_CHAT_WEIGHT_API=1
RAGV6_CHAT_DISTRIBUTED_LEASE_TTL_MS=180000

# Garnet/Redis provides cross-instance admission control and hot conversation state.
# When optional Redis is unavailable the gateway stays online with explicit
# single-instance memory degradation. Set REQUIRED=1 in a multi-instance production deployment.
RAGV6_REDIS_ENABLED=1
RAGV6_REDIS_REQUIRED=0
RAGV6_REDIS_URL=redis://127.0.0.1:6379
RAGV6_REDIS_NAMESPACE=raysource:v1
RAGV6_REDIS_CONNECT_TIMEOUT_MS=1800
RAGV6_PRODUCT_MEMORY_TTL_SECONDS=604800

# Model providers are configured only in retrieval-service-vnext/.env, never in browser code.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=replace-with-server-side-secret
# DEEPSEEK_WIRE_API=openai
