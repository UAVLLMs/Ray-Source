# RAGV6 operational alert channels.
# Copy the needed variables into web-client/.env, then restart port 3011.

# Email (SMTP). RAGV6_ALERT_SMTP_SECURE accepts: tls, starttls, plain.
RAGV6_ALERT_SMTP_HOST=smtp.example.com
RAGV6_ALERT_SMTP_PORT=465
RAGV6_ALERT_SMTP_SECURE=tls
RAGV6_ALERT_SMTP_USER=
RAGV6_ALERT_SMTP_PASS=
RAGV6_ALERT_EMAIL_FROM=
RAGV6_ALERT_EMAIL_TO=ops@example.com

# Enterprise WeChat group-bot webhook.
RAGV6_ALERT_WECOM_WEBHOOK=

# Feishu group-bot webhook.
RAGV6_ALERT_FEISHU_WEBHOOK=

# Five-minute-window thresholds and delivery controls.
RAGV6_ALERT_ERROR_RATE=20
RAGV6_ALERT_MODEL_FAILURE_RATE=10
RAGV6_ALERT_NO_EVIDENCE_RATE=40
RAGV6_ALERT_P95_MS=60000
RAGV6_ALERT_MIN_SAMPLES=5
RAGV6_ALERT_COOLDOWN_MS=600000

# Persistent monitoring retention.
RAGV6_MONITOR_RETENTION_DAYS=90
